---
import { commercialHref, hasCheckout, priceDisplay, siteConfig } from "../config/site";

const { hero, images, videos, course } = siteConfig;
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__media" aria-hidden="true" data-hero-media>
    <picture class="hero__poster" data-hero-poster>
      <source
        media="(max-width: 700px)"
        srcset={`${images.hero.mobileSmall} 720w, ${images.hero.mobile} 1122w`}
        sizes="100vw"
      />
      <img
        src={images.hero.desktop}
        srcset={`${images.hero.desktopSmall} 960w, ${images.hero.desktop} 1672w`}
        sizes="100vw"
        width="1672"
        height="941"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      data-hero-video
      data-src-desktop={videos.hero.desktop}
      data-src-mobile={videos.hero.mobile}
    ></video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content page-shell">
    <div class="hero__copy">
      <p class="claim">
        <span class="claim__rule" aria-hidden="true"></span>
        {hero.claim}
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-lead">
          {hero.titleLead.map((line) => <span>{line} </span>)}
        </span>
        <span class="text-olive-light">{hero.titleAccent}</span>
      </h1>
      <p class="hero__description">{hero.description}</p>
      <div class="hero__actions">
        <a
          class="button"
          href={commercialHref}
          data-commercial-cta
          data-cta-position="hero"
          data-checkout-ready={String(hasCheckout)}
        >
          {hero.primaryCta}
        </a>
        <a class="text-link text-link--dark" href="#contenidos">{hero.secondaryCta}</a>
      </div>
      {course.price && <p class="hero__price" data-price-copy>{priceDisplay} · pago único</p>}
    </div>
  </div>

  <ul class="hero__facts" aria-label="Resumen del curso">
    {hero.facts.map((fact) => <li>{fact}</li>)}
  </ul>

  <button
    class="hero__motion-toggle"
    type="button"
    aria-pressed="false"
    aria-label="Pausar animación de fondo"
    data-hero-motion-toggle
    hidden
  >
    <span class="hero__motion-icon" aria-hidden="true">
      <svg class="hero__motion-pause" viewBox="0 0 16 16" width="16" height="16">
        <path d="M4.25 3.25h2.5v9.5h-2.5zm5 0h2.5v9.5h-2.5z" fill="currentColor"></path>
      </svg>
      <svg class="hero__motion-play" viewBox="0 0 16 16" width="16" height="16">
        <path d="m5 3.1 7.2 4.9L5 12.9z" fill="currentColor"></path>
      </svg>
    </span>
    <span data-hero-motion-label>Pausar fondo</span>
  </button>
</section>
